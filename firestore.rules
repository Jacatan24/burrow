rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each person can only read and write their own Burrow data
    // (their main document and anything under it, like receipt photos and backups).
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Apple Pay automation: your iPhone Shortcut may ADD a purchase here,
    // but only if it includes your private Burrow key. Nobody can read these but you.
    match /users/{userId}/pay/{payId} {
      allow create: if request.resource.data.keys().hasOnly(['t'])
        && request.resource.data.t is string
        && request.resource.data.t.size() < 400
        && request.resource.data.t.split('[|]')[0] == get(/databases/$(database)/documents/users/$(userId)/private/pay).data.secret;
    }
  }
}
